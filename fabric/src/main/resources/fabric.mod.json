{
  "schemaVersion": 1,
  "id": "placeonpath",
  "version": "${version}",
  "name": "PlaceOnPath",
  "description": "Lets you place any block on dirt path blocks without turning them into dirt, and swaps the path for a full-height variant so there is no gap to the block on top.",
  "authors": [
    "Maxi"
  ],
  "contact": {
    "homepage": ""
  },
  "license": "MIT",
  "icon": "assets/placeonpath/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.maxi.placeonpath.fabric.PlaceonpathFabric"
    ],
    "client": [
      "de.maxi.placeonpath.fabric.client.PlaceonpathFabricClient"
    ]
  },
  "mixins": [
    "placeonpath.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.19.4",
    "java": ">=17",
    "architectury": ">=8.2.91",
    "fabric-api": "*"
  }
}
